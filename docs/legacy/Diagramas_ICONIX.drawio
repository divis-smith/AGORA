        <mxCell id="z35c73fcfa0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#2A2A2A;fontColor=#FFFFFF;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Nunito;" value="" vertex="1">
