        <mxCell id="z90b6825787" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Nunito;fontSize=16;fontColor=#FFFFFF;fontStyle=1;" value="CREAR CUENTA" vertex="1">
