        <mxCell id="z232da63628" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0A0A0A;strokeColor=#0A0A0A;fontColor=#FFFFFF;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Nunito;" value="" vertex="1">
