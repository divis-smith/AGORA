  <diagram name="1.1 — Registro" id="z69a82dced4">
    <mxGraphModel dx="1665" dy="841" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
